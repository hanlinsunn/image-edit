# Copy to backend/.env. Never commit real credentials.
APP_ENVIRONMENT=dev
APP_DATABASE_URL=sqlite+pysqlite:///./dev.db
APP_STORAGE_ROOT=./.storage

# "fake" returns deterministic placeholder images and costs nothing.
APP_IMAGE_EDITOR=fake
# APP_IMAGE_EDITOR=openai
# APP_OPENAI_API_KEY=sk-...
APP_OPENAI_IMAGE_MODEL=gpt-image-1

APP_APPLE_BUNDLE_ID=com.hanlinsunn.imageedit
# Accepts unverified identity tokens. Local development only.
APP_AUTH_ALLOW_INSECURE_TOKENS=false
